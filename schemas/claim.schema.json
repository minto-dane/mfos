{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfos.local/schemas/claim.schema.json",
  "title": "MFOS Assurance Claim",
  "type": "object",
  "required": [
    "claim_id",
    "profile",
    "claim",
    "protected_assets",
    "threat_scope",
    "trusted_components",
    "requirements",
    "tests",
    "evidence",
    "assumptions",
    "not_claimed",
    "residual_risks"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^MFOS-CLAIM-[A-Z0-9-]+-[0-9]{4}$"},
    "profile": {"enum": ["Baseline", "Enterprise-Standalone", "Enterprise-PXM", "High-Assurance"]},
    "claim": {"type": "string"},
    "protected_assets": {"type": "array", "items": {"type": "string"}},
    "threat_scope": {"type": "array", "items": {"type": "string"}},
    "trusted_components": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "items": {"type": "string", "pattern": "^MFOS-REQ-[A-Z0-9]+-[0-9]{4}$"}},
    "tests": {"type": "array", "items": {"type": "string", "pattern": "^(TEST|NEG)-MFOS-[A-Z0-9-]+$"}},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^EV-MFOS-[A-Z0-9-]+$"}},
    "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "not_claimed": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "residual_risks": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {"const": "Baseline"}
        },
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "not_claimed": {
            "allOf": [
              {
                "contains": {
                  "type": "string",
                  "pattern": "[Pp]rotection after nucleus compromise"
                }
              },
              {
                "contains": {
                  "type": "string",
                  "pattern": "[Pp]rotection after malicious signed AMF module compromise"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {"const": "High-Assurance"}
        },
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "evidence": {
            "allOf": [
              {
                "contains": {
                  "type": "string",
                  "pattern": "GRD"
                }
              },
              {
                "contains": {
                  "type": "string",
                  "pattern": "ATTESTATION"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfos.local/schemas/evidence.schema.json",
  "title": "MFOS Evidence Artifact",
  "type": "object",
  "required": ["evidence_id", "evidence_type", "requirement_ids", "status"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-MFOS-[A-Z0-9-]+$"},
    "evidence_type": {"type": "string"},
    "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^MFOS-REQ-[A-Z0-9]+-[0-9]{4}$"}},
    "claims": {"type": "array", "items": {"type": "string", "pattern": "^MFOS-CLAIM-[A-Z0-9-]+-[0-9]{4}$"}},
    "path": {"type": "string"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
